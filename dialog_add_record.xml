<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/etDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Нажмите, чтобы выбрать дату"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary" />

    <CheckBox
        android:id="@+id/cbMorning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Почистил(а) утром" />

    <CheckBox
        android:id="@+id/cbEvening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Почистил(а) вечером" />

    <CheckBox
        android:id="@+id/cbFloss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Использовал(а) зубную нить" />

    <EditText
        android:id="@+id/etNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Заметки (необязательно)"
        android:inputType="textMultiLine" />

</LinearLayout>